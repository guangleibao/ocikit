OCI_AUTH=
OCI_PROFILE=
OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_METADATA_BASE_URL=

# Optional stream defaults for both REST and Kafka consumers.
OCI_STREAM_NAME=
OCI_STREAM_ENDPOINT=
OCI_STREAM_GROUP_NAME=
# Python Kafka requires these credentials (SASL/PLAIN).
# Java Kafka uses instance principals when OCI_KAFKA_USERNAME/--kafka-username is absent;
# set both values to opt into user-token authentication instead.
# Quote credentials containing shell-special characters.
# Username: tenancyName/[domain/]username/streamPoolId
OCI_KAFKA_USERNAME=
OCI_KAFKA_AUTH_TOKEN=
# Optional host:port list; defaults to the selected stream pool's Kafka settings.
OCI_KAFKA_BOOTSTRAP_SERVERS=
